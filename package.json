{
  "name": "power",
  "version": "0.1.0",
  "description": "Weekly routine planner: set it once, it repeats week after week.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test",
    "build": "node scripts/build.js",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#1c6a50' --iconBackgroundColorDark '#143a2c' --splashBackgroundColor '#1c6a50' --splashBackgroundColorDark '#143a2c'",
    "bundle:android": "node scripts/bundle-android.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
